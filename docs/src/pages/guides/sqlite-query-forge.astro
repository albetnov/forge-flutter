// sqlite_query_forge quick-start guide. Same Read frame as the other guides.
// All prose and code derived from packages/sqlite_query_forge/README.md.
function highlight(src) {
  const esc = src.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const re = /(\/\/[^\n]*|#[^\n]*)|('(?:[^'\\\n]|\\.)*')|\b(final|const|var|late|class|extends|import|return|await|async|if|else|new|this|super|is|in|as|get|static|factory)\b/g;
  return esc.replace(re, (m, com, str, kw) => {
    if (com) return `<span class="tok-c">${com}</span>`;
    if (str) return `<span class="tok-s">${str}</span>`;
    if (kw) return `<span class="tok-k">${kw}</span>`;
    return m;
  });
}
const installCmd = `dart pub add sqlite_query_forge`;
const tableSnippet = `final class UsersTable extends Table<User> {
  const UsersTable() : super('users', mapper: User.fromRow);

  Column<int> get id => const Column.id();
  Column<String> get name => const Column('name');
  Column<bool> get isActive => const Column('is_active');
}

const users = UsersTable();`;
const selectSnippet = `// See "No bundled driver" at the end for the adapter itself.
final forge = Forge(MySqliteExecutor(db));

// The table mapper is applied for you.
final User user = await forge.selectFrom(users).where(users.id.eq(42)).getSingle();

// Project a few columns into a record instead of a model.
final (int, String) idAndName = await forge
    .selectFrom(users)
    .select([users.id, users.name])
    .map((row) => (row['id'] as int, row['name'] as String))
    .getSingle();`;
const filterSnippet = `var query = forge.selectFrom(users).where(users.isActive.eq(true));
if (search != null) query = query.andWhere(users.name.like('%$search%'));
if (since != null) query = query.orWhere(users.id.gt(since));`;
const joinSnippet = `final transactions = TransactionsTable();

final rows = await forge
    .selectFrom(users)
    .leftJoin(
      transactions.sourceAs('t'),
      on: users
          .qualify(users.id)
          .sameAs(transactions.qualify(transactions.userId, 't')),
    )
    .where(transactions.qualify(transactions.amount, 't').gt(100))
    .getMany();`;
const writeSnippet = `// The new rowid.
final id = await forge.insertInto(users).values({
  'name': 'Ada',
  'email': 'ada@example.com',
}).execute();

// One statement, many rows.
await forge
    .insertInto(users)
    .valuesAll([
      {'name': 'Ada', 'email': 'ada@example.com'},
      {'name': 'Grace', 'email': 'grace@example.com'},
    ])
    .execute();

// Affected rows.
final updated = await forge
    .update(users)
    .values({'is_active': false})
    .where(users.id.gt(1))
    .execute();
final deleted = await forge.deleteFrom(users).where(users.id.eq(1)).execute();`;
const upsertSnippet = `await forge
    .insertInto(users)
    .values({'email': 'ada@example.com', 'name': 'ada'})
    .onConflictIgnore()
    .execute();

await forge
    .insertInto(users)
    .values({'email': 'ada@example.com', 'name': 'ada'})
    .onConflictUpdate({
      'name': const RawSql('excluded."name"'),
    }, columns: [users.email])
    .execute();`;
const returningSnippet = `final rows = await forge
    .insertInto(users)
    .values({'name': 'Ada'})
    .returning([users.id, users.name])
    .getMany();

// Every column comes back.
final whole = await forge
    .insertInto(users)
    .values({'name': 'Ada'})
    .returning()
    .getMany();`;
const txSnippet = `await forge.transaction((tx) async {
  await tx.insertInto(users).values({'name': 'Ada'}).execute();
  await tx.transaction((nested) async {
    await nested.deleteFrom(users).where(users.id.eq(1)).execute();
  });
});`;
const compileSnippet = `final query = forge.selectFrom(users).where(users.isActive.eq(true));

query.compile();       // CompiledQuery('SELECT * WHERE "is_active" = ?', [1])
query.toSql();         // 'SELECT * FROM "users" WHERE "is_active" = ?'
query.getRawArgs();    // [1]`;
const bridgeSnippet = `final targetSchema = schemaOf(version: 2, tables: [users, transactions]);

await SqliteSchemaForge.migrate(
  db: ForgeDatabaseExecutor(forge),
  targetSchema: targetSchema,
);`;
const adapterSnippet = `final class SqfliteExecutor implements ForgeExecutor {
  SqfliteExecutor(this._db);

  final Database _db;

  @override
  Future<List<Map<String, Object?>>> query(String sql, [List<Object?>? args]) =>
      _db.rawQuery(sql, args);

  @override
  Future<int> execute(String sql, [List<Object?>? args]) =>
      _db.rawUpdate(sql, args);

  @override
  Future<int> insert(String sql, [List<Object?>? args]) =>
      _db.rawInsert(sql, args);

  @override
  Future<T> transaction<T>(Future<T> Function(ForgeExecutor txn) action) =>
      _db.transaction((txn) => action(SqfliteExecutor(txn)));
}

final executor = SqfliteExecutor(db);
final forge = Forge(executor);`;
const skillsCmd = `dart run skills@ get`;
