---
// Guides hub: the navigator for the guide series. Read frame, timetable rows.
const guides = [
  {
    code: "G1",
    pkg: "fetch_forge",
    title: "fetch_forge quick start",
    stops: "Query · Mutation · Flutter · Skills · 7 stops",
    href: "/guides/fetch-forge",
    ready: true,
  },
  {
    code: "G2",
    pkg: "sqlite_schema_forge",
    title: "sqlite_schema_forge quick start",
    stops: "Declare · Migrate · Keys/FTS · Skills · 5 stops",
    href: "/guides/sqlite-schema-forge",
    ready: true,
  },
  {
    code: "G3",
    pkg: "sqlite_query_forge",
    title: "sqlite_query_forge quick start",
    stops: "Design · Reads · Writes · Bridge · Skills · 7 stops",
    href: "/guides/sqlite-query-forge",
    ready: true,
  },
  {
    code: "G4",
    pkg: "sqlite3_driver_forge",
    title: "sqlite3_driver_forge quick start",
    stops: "Connect · Serialize · Encrypt · Limits · Skills · 7 stops",
    href: "/guides/sqlite3-driver-forge",
    ready: true,
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Guides for The Forge Ecosystem: quick-start overviews for fetch_forge and the SQLite trio."
    />
    <title>Guides: The Forge Ecosystem</title>
    <style is:global>
      :root {
        --paper: #fbfaf6;
        --paper-deep: #f3efe4;
        --ink: #16202c;
        --ink-soft: #43536a;
        --rule: #e0d9c6;
        --board: #141c28;
        --board-rule: #2a3547;
        --board-ink: #f2efe6;
        --board-soft: #b9c2d0;
        --red: #b3271e;
        --red-bright: #ff8a7a;
        --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas,
          "Liberation Mono", monospace;
        --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 1.0625rem;
        line-height: 1.65;
      }
      ::selection { background: var(--red); color: #fff; }
      :focus-visible {
        outline: 2px solid var(--red);
        outline-offset: 3px;
        border-radius: 4px;
      }
      ::-webkit-scrollbar { width: 12px; }
      ::-webkit-scrollbar-track { background: var(--paper-deep); }
      ::-webkit-scrollbar-thumb {
        background: var(--ink-soft);
        border-radius: 8px;
        border: 3px solid var(--paper-deep);
      }
      .wrap { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; }
      .masthead {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        padding: 1.25rem 0 0.75rem;
        border-bottom: 2px solid var(--ink);
      }
      .wordmark {
        margin: 0;
        font-size: 1rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 800;
      }
      .wordmark a { color: inherit; text-decoration: none; }
      .wordmark .rule-red { color: var(--red); }
      .masthead nav { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.9375rem; }
      .masthead nav a { color: var(--ink-soft); text-underline-offset: 4px; }
      .masthead nav a:hover { color: var(--red); }
      .masthead nav a[aria-current="page"] { color: var(--ink); font-weight: 700; }
      .band {
        background: var(--board);
        color: var(--board-ink);
        border-radius: 14px;
        margin: 1.75rem 0 0;
        padding: 2rem clamp(1.25rem, 4vw, 2.5rem);
        box-shadow: 10px 14px 28px rgba(20, 28, 40, 0.28);
      }
      .band h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.1;
        letter-spacing: -0.025em;
        font-weight: 800;
        text-wrap: balance;
      }
      .band h1 .t-red { color: var(--red-bright); }
      .band .lede { margin: 0.9rem 0 0; color: var(--board-soft); max-width: 68ch; }
      .lines {
        list-style: none;
        margin: 2.5rem 0 0;
        padding: 0;
        border-top: 2px solid var(--ink);
      }
      .lines li { border-bottom: 1px solid var(--rule); }
      .lines a {
        display: grid;
        grid-template-columns: 3.5rem 1fr auto;
        column-gap: 1rem;
        align-items: center;
        padding: 1rem 0.25rem;
        color: var(--ink);
        text-decoration: none;
      }
      .lines a:hover .title { color: var(--red); }
      .lines .code {
        font-family: var(--mono);
        font-size: 0.8125rem;
        color: var(--red);
        font-weight: 700;
        border: 1px solid var(--rule);
        border-radius: 6px;
        text-align: center;
        padding: 0.2rem 0;
      }
      .lines .title { font-weight: 800; font-size: 1rem; letter-spacing: -0.01em; }
      .lines .stops { display: block; font-weight: 400; font-size: 0.9375rem; color: var(--ink-soft); margin-top: 0.15rem; }
      .lines .status {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        color: var(--ink-soft);
        border: 1px solid var(--rule);
        border-radius: 999px;
        padding: 0.3rem 0.8rem;
        font-variant-numeric: tabular-nums;
      }
      .lines a:hover .status { border-color: var(--ink); color: var(--ink); }
      .after {
        margin: 2.5rem 0 0;
        color: var(--ink-soft);
        max-width: 70ch;
      }
      .after a { color: var(--ink); text-underline-offset: 4px; }
      .after a:hover { color: var(--red); }
      .pointer {
        margin: 0.75rem 0 0;
        color: var(--ink-soft);
        max-width: 70ch;
        font-size: 0.9375rem;
      }
      .pointer code {
        font-family: var(--mono);
        font-size: 0.875em;
        background: var(--paper-deep);
        border: 1px solid var(--rule);
        border-radius: 6px;
        padding: 0.1em 0.35em;
        color: var(--ink);
      }
      footer {
        margin-top: 3rem;
        border-top: 2px solid var(--ink);
        padding: 1.5rem 0 2.5rem;
        color: var(--ink-soft);
        font-size: 0.875rem;
      }
      footer .wrap { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; }
      footer a { color: var(--ink); text-underline-offset: 4px; }
      footer a:hover { color: var(--red); }
      @media (max-width: 56rem) {
        .lines a { grid-template-columns: 3rem 1fr; }
        .lines .status { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="masthead">
        <p class="wordmark"><a href="/">The Forge <span class="rule-red">/</span> Ecosystem</a></p>
        <nav aria-label="Primary">
          <a href="/#departures">Departures</a>
          <a href="/guides/" aria-current="page">Guides</a>
          <a href="https://github.com/albetnov/the_forge_ecosystem">GitHub</a>
        </nav>
      </div>
    </div>

    <div class="wrap">
      <div class="band">
        <h1>Guides <span class="t-red">by line</span></h1>
        <p class="lede">
          One quick-start overview per package, each derived from its README.
          Read in line order: remote data first, then the SQLite chain from
          schema to query to driver.
        </p>
      </div>

      <ol class="lines">
        {
          guides.map((g) => (
            <li>
              <a href={g.href}>
                <span class="code">{g.code}</span>
                <span class="title">{g.title}<span class="stops">{g.stops}</span></span>
                <span class="status">READY</span>
              </a>
            </li>
          ))
        }
      </ol>

      <p class="after">
        Each guide names its README source and stays beneath it: the package
        READMEs remain authoritative. Series order follows the dependency
        chain, <a href="/">back to all departures</a>.
      </p>

      <p class="pointer">
        Every line also ships agent skills for your coding agent, installed with
        one command per package, <code>dart run skills@ get</code>. Each guide
        closes with that package's skills; all 14 are mirrored at the repository
        root under <code>skills/</code> for <code>npx skills</code>.
      </p>
    </div>

    <footer>
      <div class="wrap">
        <span>Four lines, four guides, one timetable.</span>
        <span><a href="https://github.com/albetnov/the_forge_ecosystem">Monorepo</a> · <a href="https://github.com/albetnov/the_forge_ecosystem/blob/main/LICENSE">MIT</a></span>
      </div>
    </footer>
  </body>
</html>
