// fetch_forge quick-start guide. Read mode inside the timetable world:
// world owns the frame (band, TOC, code/table setting), column stays calm.
// All prose and code derived from packages/fetch_forge/README.md.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
function highlight(src) {
  const esc = src.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const re = /(\/\/[^\n]*|#[^\n]*)|('(?:[^'\\\n]|\\.)*')|\b(final|const|var|late|class|extends|import|return|await|async|if|else|new|this|super|is|in|as|get|static|factory)\b/g;
  return esc.replace(re, (m, com, str, kw) => {
    if (com) return `<span class="tok-c">${com}</span>`;
    if (str) return `<span class="tok-s">${str}</span>`;
    if (kw) return `<span class="tok-k">${kw}</span>`;
    return m;
  });
}
const installYaml = `dependencies:
  fetch_forge: ^0.3.0
  signals: ^7.1.0`;
const installPath = `dependencies:
  fetch_forge:
    path: ../fetch_forge`;
const cliCmd = `dart run --enable-asserts example/cli/bin/fetch_forge.dart`;
const queryHello = `Future<List<String>> fetchUsers(int page) async => ['ada', 'grace', 'alan'];

final users = Query<List<String>, int>(
  fetcher: fetchUsers,
  staleTime: const Duration(seconds: 30),
);
final page = signal(1);

// One line wires the variables signal to the fetch.
users.bind(page);
await Future<void>.delayed(Duration.zero);
print(users.snapshot.value);

page.value = 2; // New variables, new fetch, same binding.
users.dispose(); // The binding and the signals, together.`;
const querySignals = `final query = Query<List<String>, int>(fetcher: fetchUsers);
final page = signal(1);

query.bind(page); // The variables signal drives the fetch. One call, owned.

// Derived state, same as for any other signal.
final names = computed(() => switch (query.snapshot.value) {
      AsyncValueData(:final value) => value,
      _ => const <String>[],
    });

// An effect that re-runs on every change, with no widget in sight.
page.value = 2; // New variables, new fetch, same binding.
query.dispose();`;
const queryVars = `final users = Query<List<String>, ({int page, String tag})>(
  fetcher: (variables) => api.users(variables.page, variables.tag),
);

// A record has structural equality out of the box.
await users.watch((page: 1, tag: 'newest'));`;
const queryCacheKey = `final filtered = Query<Page, Filter>(
  fetcher: (filter) => api.page(filter.page),
  cacheKey: (filter) => filter.page, // 'nonce' no longer forks the cache
);`;
const queryClient = `final client = QueryClient();
final users = Query<List<String>, int>(fetcher: fetchUsers, client: client);

await users.watch(1); // every query on this client sharing key 1 shares one fetch`;
const mutBasic = `final createUser = Mutation<String, String>(
  mutator: (name) async => name,
  cacheDuration: const Duration(minutes: 5),
);

// Fire and forget: the failure lands on 'error', it never throws here.
createUser.mutate('ada').ignore();

// Await the value instead: this one rethrows, like calling the API directly.
final user = await createUser.mutateAsync('ada');`;
const mutLoop = `final client = QueryClient();
final users = Query<List<String>, int>(fetcher: fetchUsers, client: client);
final createUser = Mutation<String, int>(
  mutator: (page) async => 'grace',
  client: client,
  cacheDuration: const Duration(minutes: 5),
);

await users.watch(1);
await createUser.mutate(1); // the new user is in the cache now
createUser.invalidateCache(1); // ...and the list refetches it`;
const fqBuilder = `final page = signal(1);

QueryScope(
  client: client,
  child: QueryBuilder<List<String>, int>(
    fetcher: fetchUsers,
    variables: page,
    staleTime: const Duration(seconds: 30),
    builder: (context, query) => switch (query.snapshot.value) {
      AsyncValueData(:final value) => Text(value.join(', ')),
      AsyncValueLoading() => const Text('Loading...'),
      AsyncValueError(:final error) => Text('Failed: $error'),
      AsyncValueIdle() => const Text('Idle'),
    },
  ),
);`;
const fqManual = `final load = signal(0);

QueryBuilder<List<String>, int>(
  fetcher: fetchUsers,
  variables: page,
  autoFetch: false,   // no fetch on mount, no fetch on a variables change
  refresh: load,      // each bump fetches with the current variables
  builder: (context, query) => switch (query.snapshot.value) {
    AsyncValueIdle() => FilledButton(
      onPressed: () => load.value++,
      child: const Text('Load users'),
    ),
    AsyncValueLoading() => const Text('Loading...'),
    AsyncValueData(:final value) => Text(value.join(', ')),
    AsyncValueError(:final error) => Text('Failed: $error'),
  },
);`;
const fqMutation = `MutationBuilder<int, String>(
  mutator: createUser,
  builder: (context, mutation) => ElevatedButton(
    onPressed: () => mutation.mutate('ada').ignore(),
    child: Text(mutation.isPending.value ? 'Saving...' : 'Save'),
  ),
);`;
const fqTrigger = `final submit = signal(0);
final name = signal('ada');

MutationBuilder<int, String>(
  mutator: createUser,
  variables: name,   // the variables the write runs with
  trigger: submit,   // any bump starts the write
  builder: (context, mutation) => Text(
    mutation.isPending.value ? 'Saving...' : 'Save',
  ),
);

submit.value++; // The write runs with 'name.value'.`;
const demoCmd = `cd example/app && flutter run -d chrome`;
const recipeOpt = `final page = signal(1);
query.setData([...query.data.value ?? const [], newUser], page.value);

// If the write fails, roll back by seeding again with the previous value.`;
const recipeInv = `final client = QueryClient();
final users = Query<List<String>, int>(fetcher: fetchUsers, client: client);
final createUser = Mutation<String, int>(
  mutator: (page) async => 'grace',
  client: client,
);

void onUserCreated(int page) {
  createUser.invalidateCache(page);
}`;
const skillsCmd = `dart run skills@ get`;
