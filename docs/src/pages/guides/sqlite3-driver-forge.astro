// sqlite3_driver_forge quick-start guide. Same Read frame as the other guides.
// All prose and code derived from packages/sqlite3_driver_forge/README.md.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
function highlight(src) {
  const esc = src.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const re = /(\/\/[^\n]*|#[^\n]*)|('(?:[^'\\\n]|\\.)*')|\b(final|const|var|late|class|extends|import|return|await|async|if|else|new|this|super|is|in|as|get|static|factory|try|catch|finally|throw)\b/g;
  return esc.replace(re, (m, com, str, kw) => {
    if (com) return `<span class="tok-c">${com}</span>`;
    if (str) return `<span class="tok-s">${str}</span>`;
    if (kw) return `<span class="tok-k">${kw}</span>`;
    return m;
  });
}
const installCmd = `dart pub add sqlite3_driver_forge`;
const wireSnippet = `import 'package:sqlite3_driver_forge/sqlite3_driver_forge.dart';
import 'package:sqlite_query_forge/sqlite_query_forge.dart';
import 'package:sqlite_schema_forge/sqlite_schema_forge.dart' as schema;

final driver = SqliteDriver.file('/data/app.db');
await driver.connect();

await schema.SqliteSchemaForge.migrate(
  db: driver, // DatabaseExecutor
  targetSchema: schema.Schema(version: 1, tables: [...]),
);

final forge = Forge(driver); // ForgeExecutor`;
const useSnippet = `final driver = SqliteDriver.file('/data/app.db');
await driver.connect();
try {
  await driver.execute('CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);');
  final id = await driver.insert('INSERT INTO t (v) VALUES (?);', ['hi']);
  final rows = await driver.query('SELECT * FROM t WHERE id = ?;', [id]);

  await driver.transaction((txn) async {
    await txn.execute("INSERT INTO t (v) VALUES ('atomic');");
  });

  await driver.backupTo('/data/app.backup.db');
} finally {
  await driver.disconnect();
}`;
const cipherYaml = `hooks:
  user_defines:
    sqlite3:
      source: sqlite3mc # or: sqlcipher`;
const cipherSnippet = `final password = SecurePassword.text(await loadFromSecureStorage());
try {
  await driver.connect(cipher: password);
} finally {
  password.dispose(); // zero the bytes; the driver retains nothing
}`;
const skillsCmd = `dart run skills@ get`;
