      }
      figure.code pre code { font-variant-numeric: tabular-nums; }
      .tok-k { color: var(--ink); font-weight: 700; }
      .tok-s { color: #8f1f18; }
      .tok-c { color: var(--ink-soft); font-style: italic; }
      .note {
        border: 1px solid var(--rule);
        border-radius: 12px;
        background: #fff;
