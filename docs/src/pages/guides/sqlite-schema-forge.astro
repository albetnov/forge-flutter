        font-size: 0.875rem;
      }
      footer .wrap { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; }
      footer a { color: var(--ink); text-underline-offset: 4px; }
      footer a:hover { color: var(--red); }
      @media (max-width: 56rem) {
        table.scope, table.scope tbody, table.scope tr, table.scope th, table.scope td { display: block; }
        table.scope th, table.scope td { border-bottom: 0; padding: 0.45rem 1rem; }
        table.scope tr { border-bottom: 1px solid var(--rule); }
        table.scope tr:last-child { border-bottom: 0; }
        table.scope th { padding-bottom: 0; }
        table.scope td { padding-top: 0.25rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
