---
// Forge docs landing: single route. Timetable direction, code-led.
// All copy and code from the monorepo READMEs; links follow known paths.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const lines = [
  {
    id: "fetch",
    platform: "P1",
    pkg: "fetch_forge",
    runs: "Remote data behind signals",
    provides: "Query · Mutation · QueryBuilder · MutationBuilder · QueryScope",
    depends: "Standalone · pairs with package:signals",
    version: "0.3.0",
    short: "STANDALONE",
    add: "dart pub add fetch_forge",
    links: [
      { label: "README", href: "https://github.com/albetnov/forge-flutter/tree/main/packages/fetch_forge" },
      { label: "pub.dev", href: "https://pub.dev/packages/fetch_forge" },
    ],
  },
  {
    id: "schema",
    platform: "P2",
    pkg: "sqlite_schema_forge",
    runs: "Declarative schema + auto-migration",
    provides: "Schema · Table · Column · plan / applyPlan",
    depends: "Origin of the SQLite chain",
    version: "0.1.1",
    short: "ORIGIN",
    add: "dart pub add sqlite_schema_forge",
    links: [
      { label: "README", href: "https://github.com/albetnov/forge-flutter/tree/main/packages/sqlite_schema_forge" },
      { label: "pub.dev", href: "https://pub.dev/packages/sqlite_schema_forge" },
    ],
  },
  {
    id: "query",
    platform: "P3",
    pkg: "sqlite_query_forge",
    runs: "Zero-cost declarative queries",
    provides: "SelectBuilder · Expression · bound args",
    depends: "Via P2 · schema types",
    version: "0.4.0",
    short: "VIA P2",
    add: "dart pub add sqlite_query_forge",
    links: [
      { label: "README", href: "https://github.com/albetnov/forge-flutter/tree/main/packages/sqlite_query_forge" },
      { label: "pub.dev", href: "https://pub.dev/packages/sqlite_query_forge" },
    ],
  },
  {
    id: "driver",
    platform: "P4",
    pkg: "sqlite3_driver_forge",
    runs: "Background-isolate driver",
    provides: "ForgeExecutor · DatabaseExecutor · SQLCipher",
    depends: "Via P2 · P3 · serves both contracts",
    version: "0.1.3",
    short: "VIA P2·P3",
    add: "dart pub add sqlite3_driver_forge",
    links: [
      { label: "README", href: "https://github.com/albetnov/forge-flutter/tree/main/packages/sqlite3_driver_forge" },
      { label: "pub.dev", href: "https://pub.dev/packages/sqlite3_driver_forge" },
    ],
  },
];
const fetchSnippet = `Future<List<String>> fetchUsers(int page) async => ['ada', 'grace', 'alan'];

final users = Query<List<String>, int>(
  fetcher: fetchUsers,
  staleTime: const Duration(seconds: 30),
);
final page = signal(1);

// One line wires the variables signal to the fetch.
users.bind(page);
await Future<void>.delayed(Duration.zero);
print(users.snapshot.value);

page.value = 2; // New variables, new fetch, same binding.`;
const schemaSnippet = `final appSchema = Schema(
  version: 1,
  tables: [
    Table(
      'wallets',
      [
        Column.id(),
        Column.text('name', nullable: false),
        Column.integer('wallet_type_id', nullable: false),
        Column.datetime('created_at',
            defaultValue: RawSql.currentTimestamp),
      ],
      indexes: [
        Index(columns: ['wallet_type_id']),
      ],
    ),
  ],
);`;
const querySnippet = `final class UsersTable extends Table<User> {
  const UsersTable() : super('users', mapper: User.fromRow);

  Column<int> get id => const Column.id();
  Column<String> get name => const Column('name');
  Column<bool> get isActive => const Column('is_active');
}

const users = UsersTable();
final forge = Forge(MySqliteExecutor(db));

// The table mapper is applied for you.
final User user = await forge.selectFrom(users).where(users.id.eq(42)).getSingle();`;
const driverSnippet = `final driver = SqliteDriver.file('/data/app.db');
await driver.connect();

await schema.SqliteSchemaForge.migrate(
  db: driver, // DatabaseExecutor
  targetSchema: schema.Schema(version: 1, tables: [...]),
);

final forge = Forge(driver); // ForgeExecutor`;
// Agent work order: one prompt, one <usage> slot the visitor fills or leaves.
const agentPrompt = `You are adding The Forge Ecosystem packages to this repository.

Requested usage: <usage>

Step 1 — resolve the usage.
If the line above still reads <usage>, stop and ask me which packages I want:
  fetch  — remote data (fetch_forge)
  schema — declarative SQLite schema and migrations (sqlite_schema_forge)
  query  — typed SQLite query builder (sqlite_query_forge)
  driver — background-isolate SQLite driver (sqlite3_driver_forge)
  sqlite — the whole SQLite chain, schema to query to driver
Wait for my answer before doing anything else. A filled-in value maps the same way.

Step 2 — read this project before changing it.
Confirm it is a Dart or Flutter project (pubspec.yaml) with SDK ^3.13.4; if not, stop and say so. Then find every existing persistence or remote-data layer: sqflite, drift or moor, floor, hive, isar, objectbox, sqlite3, sqlite_async, and hand-written database code.

Step 3 — ask before you overlap.
If something already covers the requested usage, do not add the Forge packages yet. Tell me what you found, which line overlaps it, and ask whether to replace it, run both, or stop. If nothing overlaps, or I say replace, continue.

Step 4 — install.
Use this project's package manager: flutter pub add in a Flutter project, dart pub add otherwise. Add the pub.dev releases of the chosen packages, and signals alongside fetch_forge, whose state is signal state. Then run dart run skills@ get and read what lands in .agents/skills/ before writing any code.

Step 5 — wire it up from the installed skills and the package READMEs, never from memory.
  fetch_forge — declare Query<T, V> and drive it from a variables signal;
    wrap it in QueryScope when widgets share a client.
  sqlite_schema_forge — declare Schema(version, tables) and run
    SqliteSchemaForge.migrate(db:, targetSchema:).
  sqlite_query_forge — declare Table subclasses and query through
    Forge(driver): selectFrom, insertInto, update, deleteFrom.
  sqlite3_driver_forge — connect one SqliteDriver and hand that same instance
    to the migrator and to Forge.
A partial choice still brings its dependencies: query needs schema; driver needs schema and query. Ask before running any destructive migration.

When you are done, report the packages added, the files changed, anything you replaced, and the command that runs it.`;
function slotHtml(src) {
  const esc = src.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  return esc.replace(/&lt;usage&gt;/g, '<span class="slot">&lt;usage&gt;</span>');
}
// Build-time Dart highlighter: comments, strings, keywords. Zero runtime cost.
function highlight(src) {
  const esc = src.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const re = /(\/\/[^\n]*)|('(?:[^'\\\n]|\\.)*')|\b(final|const|var|late|class|extends|import|return|await|async|if|else|new|this|super|is|in|as|get|static|factory)\b/g;
  return esc.replace(re, (m, com, str, kw) => {
    if (com) return `<span class="tok-c">${com}</span>`;
    if (str) return `<span class="tok-s">${str}</span>`;
    if (kw) return `<span class="tok-k">${kw}</span>`;
    return m;
  });
}
